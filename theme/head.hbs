<!-- Markdown -->
<!--
The markdown of the page, and the llms.txt index of the book, for the language
models, after https://llmstxt.org: "make llms" lays them next to the html
pages. The print page, the whole book, has llms-full.txt for markdown.
-->
{{#if is_print}}
<link rel="alternate" type="text/markdown" href="{{ path_to_root }}llms-full.txt">
{{else}}
<link rel="alternate" type="text/markdown" href="{{ path_to_root }}{{ path }}">
{{/if}}
<link rel="describedby" href="{{ path_to_root }}llms.txt">
<!-- End markdown -->

<!-- Version picker -->
<script>
// One book is built per agent release: the book of the latest release is
// deployed at the site root, the book of an earlier release under its own
// path, so the reader has to be told which one they are reading and given a
// way to move between them. The list of releases lives at the site root,
// outside any of them, because a book cannot know about the releases that
// come after it.
(function () {
  function build(versions) {
    var bar = document.getElementById("menu-bar") || document.getElementById("mdbook-menu-bar");
    if (!bar || !versions || !versions.length) {
      return;
    }
    // A version is {"name": "v3.1", "path": "/"} or {"name": "v3.0", "path":
    // "/v3.0/"}: the name is what the reader picks from, the path is where
    // that book is deployed. The book read is the one of the longest path
    // the page is under: every page is under "/".
    var page = window.location.pathname;
    var current = null;
    versions.forEach(function (version) {
      if (page.indexOf(version.path) === 0 && (!current || version.path.length > current.path.length)) {
        current = version;
      }
    });
    if (!current) {
      return;
    }
    var rest = page.slice(current.path.length);
    var buttons = bar.querySelector(".right-buttons") || bar;
    var select = document.createElement("select");
    select.className = "version-picker";
    select.setAttribute("aria-label", "documentation version");
    versions.forEach(function (version) {
      var option = document.createElement("option");
      option.value = version.path;
      option.textContent = version.name;
      option.selected = version === current;
      select.appendChild(option);
    });
    select.addEventListener("change", function () {
      // The same page of the chosen release, and its home page when that
      // release has no such page: a keyword that was added or removed is
      // exactly what a reader switches versions to check.
      window.location.href = this.value + rest;
    });
    buttons.appendChild(select);
  }

  window.addEventListener("DOMContentLoaded", function () {
    fetch("/versions.json", { cache: "no-cache" })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(build)
      .catch(function () { /* no list, no picker */ });
  });
})();
</script>
<!-- End version picker -->

<!-- Matomo -->
<script>
  var _paq = window._paq = window._paq || [];
  /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
  _paq.push(['trackPageView']);
  _paq.push(['enableLinkTracking']);
  (function() {
    var u="//matomo.opensvc.com/";
    _paq.push(['setTrackerUrl', u+'matomo.php']);
    _paq.push(['setSiteId', '2']);
    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
    g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
  })();
</script>
<!-- End Matomo Code -->
